# copy → .env on server, then: pip install flask requests lark-oapi && python main.py
#
# Feishu console → Events → Receive events through persistent connection
# Also subscribe: im.message.receive_v1 + card.action.trigger (VPN pick buttons)
# IMPORTANT: run python main.py FIRST, wait for "connected to wss://", THEN save in console.

# feishu = 国内 open.feishu.cn | lark = 国际 open.larksuite.com（APP 在哪个后台创建就用哪个）
LARK_HOST=https://open.feishu.cn
LARK_DOMAIN=feishu
APP_ID=
APP_SECRET=
VERIFICATION_TOKEN=

PORT=5008

NOTIFY_CHAT_ID=
NOTIFY_USER_OPEN_ID=
DUTY_BOT_OPEN_ID=ou_1f6596a9923a2a835918e7e2513595d5

JENKINS_USER=
JENKINS_PASSWORD=
JENKINS_POLL_SECONDS=1
JENKINS_STUCK_SECONDS=300

createvpnid=
createvpnpass=

# find vpn file <name>[,<name>…]  — how far back to scan, how many buttons on the picker card,
# and how long an unfinished picker stays clickable.
VPN_FIND_MAX_BUILDS=100
VPN_FIND_MAX_BUTTONS=20
VPN_FIND_SESSION_TTL_SEC=1800

# VPN Playwright pre-warm (same as duty bot — needs osedutybot on server)
VPN_WARM_BROWSER=1
VPN_WARM_PREWARM_ON_STARTUP=1
DUTY_BOT_ROOT=/root/osedutybot
# JENKINS_WARM_STARTUP_WAIT_SEC=120

DUTY_BOT_HOST=127.0.0.1
DUTY_BOT_PORT=5000

# optional: public webhook instead of persistent connection
# LARK_EVENT_MODE=webhook

# ---- Console log delivery ----------------------------------------------------------------
# The done card shows the console in an expand/collapse block, and the full log is attached
# as {pipeline}.log in the same thread.
# Nothing is ever omitted from the log you receive. Feishu caps a chat attachment at 30 MB
# (im/v1/files, error 234006) — there is no chunked upload and msg_type "file" takes only a
# file_key, so a console bigger than that CANNOT be one attachment at whatever name or type.
# Default behaviour: one plain {pipeline}.log when it fits; above 30 MB nothing is attached and
# the card states the size and links Jenkins' own consoleText, which is one URL to the one whole
# unsplit uncompressed log.
#
# JENKINS_LOG_CARD_MAX_BYTES : raw log bytes to TRY embedding in the card panel (clamped 0-24000).
#   The card is auto-shrunk below Lark's 30 KB message cap regardless, so raising this is safe.
#   The panel can never hold more than ~24 KB — that is the message cap, not a choice.
# JENKINS_LOG_FILE_MAX_BYTES : the attachment ceiling (clamped 4096 - 30,000,000). Decimal MB on
#   purpose: 30 MiB would be 1.4 MB over a decimal cap and rejected with 234006.
# JENKINS_LOG_FILE_ENABLED=0 turns the attachment off entirely (the card panel stays).
# JENKINS_LOG_SINGLE_FILE_ONLY=0 allows an over-ceiling log to be SPLIT into
#   {pipeline}.partNofM.log files — every byte, but several things to click.
# JENKINS_LOG_GZIP=1 instead delivers ONE small {pipeline}.log.gz (~200 MB -> under 1 MB), the
#   only way to get a whole huge log as a single attachment. Needs unzipping to read.
# JENKINS_LOG_PANEL_EXPANDED=0 starts the console panel collapsed — try it if a long panel makes
#   the Feishu client add its own "…more".
JENKINS_LOG_CARD_MAX_BYTES=24000
JENKINS_LOG_FILE_MAX_BYTES=30000000
JENKINS_LOG_FILE_ENABLED=1
JENKINS_LOG_PANEL_EXPANDED=1
JENKINS_LOG_SINGLE_FILE_ONLY=1
JENKINS_LOG_GZIP=0
JENKINS_LOG_PANEL_CODE_BLOCK=1
