# =============================================================================
# jenkinsbot — copy to `.env` on OSE-Tools (example: PORT=5008)
# =============================================================================
#
# 启动：`python main.py`（默认长连接 / Subscription mode，无需公网 URL）
# Lark 飞书后台 → 事件与回调 → Subscription mode：
#   **Receive events through persistent connection**（长连接）
#
# 若要用公网 Request URL webhook，在 .env 加：LARK_EVENT_MODE=webhook
#
# jenkinsbot 只处理 Jenkins 命令（链接、/SuccessSendVpnConf、/FindVpnConf），不用 LLM。
# =============================================================================

# ----- Lark / Feishu (required) -----
LARK_HOST=https://open.feishu.cn
APP_ID=
APP_SECRET=
VERIFICATION_TOKEN=
LARK_DOMAIN=feishu

# Flask listen (your server uses 5008)
PORT=5008

# persistent connection (default) — local forward target for WebSocket events
LARK_EVENT_MODE=websocket
LARK_LOCAL_WEBHOOK_URL=http://127.0.0.1:5008/webhook/event

# ----- Lark notify (required) -----
NOTIFY_CHAT_ID=

# @ 完成卡片 / stuck / duty 通知的人（OM duty）
# 任选其一：JENKINS_TAG_OPEN_ID / omduty / NOTIFY_USER_OPEN_ID（旧名仍可用）
omduty=ou_d7bc33724e2d6ced4050c944c2ca5650

# Duty Bot 应用 open_id（HTTP 回调用，不是卡片 @）
DUTY_BOT_OPEN_ID=ou_1f6596a9923a2a835918e7e2513595d5

# ----- Jenkins client8 -----
JENKINS_USER=
JENKINS_PASSWORD=
JENKINS_POLL_SECONDS=1
JENKINS_STUCK_SECONDS=300

# ----- VPN Aliyun (VPN_CREATION) -----
createvpnid=
createvpnpass=

# ----- Duty bot ↔ jenkinsbot（同机 OSE-Tools）-----
DUTY_BOT_HOST=127.0.0.1
DUTY_BOT_PORT=5000
# 两台 bot .env 填相同随机串
DUTY_INTERNAL_TOKEN=
JENKINS_INTERNAL_TOKEN=

# ----- Optional -----
VPN_FIND_MAX_BUILDS=100
# DUTY_REPLY_UPDATE_URL=http://127.0.0.1:5000/internal/reply-update-email
# DUTY_UPDATEMORE_CALLBACK_URL=http://127.0.0.1:5000/internal/updatemore-jenkins-callback
