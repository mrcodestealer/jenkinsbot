# copy → .env on server, then: pip install flask requests lark-oapi && python main.py
#
# Feishu console → Events → Receive events through persistent connection
# Also subscribe: im.message.receive_v1 + card.action.trigger (VPN pick buttons)
# IMPORTANT: run python main.py FIRST, wait for "connected to wss://", THEN save in console.

# feishu = 国内 open.feishu.cn | lark = 国际 open.larksuite.com（APP 在哪个后台创建就用哪个）
LARK_HOST=https://open.feishu.cn
LARK_DOMAIN=feishu
APP_ID=
APP_SECRET=
VERIFICATION_TOKEN=

PORT=5008

NOTIFY_CHAT_ID=
NOTIFY_USER_OPEN_ID=
DUTY_BOT_OPEN_ID=ou_1f6596a9923a2a835918e7e2513595d5

JENKINS_USER=
JENKINS_PASSWORD=
JENKINS_POLL_SECONDS=1
JENKINS_STUCK_SECONDS=300

createvpnid=
createvpnpass=

# find vpn file <name>[,<name>…]  — how far back to scan, how many buttons on the picker card,
# and how long an unfinished picker stays clickable.
VPN_FIND_MAX_BUILDS=100
VPN_FIND_MAX_BUTTONS=20
VPN_FIND_SESSION_TTL_SEC=1800

# VPN Playwright pre-warm (same as duty bot — needs osedutybot on server)
VPN_WARM_BROWSER=1
VPN_WARM_PREWARM_ON_STARTUP=1
DUTY_BOT_ROOT=/root/osedutybot
# JENKINS_WARM_STARTUP_WAIT_SEC=120

DUTY_BOT_HOST=127.0.0.1
DUTY_BOT_PORT=5000

# optional: public webhook instead of persistent connection
# LARK_EVENT_MODE=webhook

# ---- Console log delivery ----------------------------------------------------------------
# The done card shows the console in an expand/collapse block, and the full log is attached
# as {pipeline}.log in the same thread.
# The attached log is ALWAYS the complete console — nothing is ever omitted. A log over Lark's
# 30 MB per-upload ceiling is gzipped to {pipeline}.log.gz (a Jenkins console compresses 10-30x,
# so ~190 MB lands under 1 MB), and split into {pipeline}.partNofM.log.gz only if even the gzip
# is over. The card panel can only ever hold ~24 KB — that is Lark's 30 KB message cap, not a
# choice — so for a huge build the panel is the tail and the attachment is the whole thing.
#
# JENKINS_LOG_CARD_MAX_BYTES : raw log bytes to TRY embedding in the card (clamped 0-24000).
#   The card is auto-shrunk below Lark's 30 KB body cap regardless, so raising this is safe.
# JENKINS_LOG_FILE_MAX_BYTES : per-upload ceiling, i.e. the SPLIT threshold (clamped 4096 - 30 MB).
#   Never a truncation point. Lowering it only fragments delivery; it cannot lose bytes.
# JENKINS_LOG_FILE_ENABLED=0 turns the attachment off (the card panel stays).
# JENKINS_LOG_PANEL_EXPANDED=0 starts the panel collapsed — try it if a long panel makes the
#   Feishu client add its own "…more".
# JENKINS_LOG_GZIP=1 delivers ONE small {pipeline}.log.gz instead of plain .log files. Default
#   is 0 = plain .log, which opens with no unzip step. Lark refuses any single upload over 30 MB,
#   so a console bigger than that arrives as {pipeline}.partNofM.log either way — gzip trades
#   those N big uploads for one tiny one (~190 MB -> under 1 MB). Neither setting loses a byte.
# JENKINS_LOG_PANEL_CODE_BLOCK=0 drops the ``` fence if it ever misrenders in the panel.
JENKINS_LOG_CARD_MAX_BYTES=24000
JENKINS_LOG_FILE_MAX_BYTES=31457280
JENKINS_LOG_FILE_ENABLED=1
JENKINS_LOG_PANEL_EXPANDED=1
JENKINS_LOG_GZIP=0
JENKINS_LOG_PANEL_CODE_BLOCK=1
